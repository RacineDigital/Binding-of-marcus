{
  "name": "lost-marcus",
  "private": true,
  "version": "3.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tsx tests/run.ts",
    "smoke": "tsx tests/smoke.ts",
    "test:boot": "tsx tests/boot.ts",
    "test:e2e": "tsx tests/e2e.ts && tsx tests/controller.ts && tsx tests/feel.ts && tsx tests/inklings.ts && tsx tests/ambience.ts",
    "test:soak": "tsx tests/soak.ts",
    "test:extreme": "tsx tests/tools/extreme.ts",
    "test:synergy": "tsx tests/synergy.ts",
    "build:single": "tsc --noEmit && vite build --mode single",
    "release": "bash scripts/package-release.sh",
    "desktop": "npm run build:single && electron .",
    "dist:win": "npm run build:single && electron-builder --win --publish never",
    "test:desktop": "node --test tests/desktop-distribution.test.cjs",
    "dist:steam": "npm run build:single && electron-builder --win --dir --publish never --config steam/electron-builder.cjs",
    "dist:itch": "npm run build:single && electron-builder --win zip --publish never --config.extraMetadata.distribution=itch --config.directories.output=release-itch",
    "package:itch": "bash scripts/package-itch.sh",
    "music:render": "node scripts/render-soundtrack.mjs",
    "steam:media": "tsx scripts/steam-media.ts",
    "steam:upload": "node scripts/steam-upload.mjs",
    "notices": "node scripts/notices.mjs",
    "dist:linux": "npm run build:single && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "steamworks.js": "0.4.0"
  },
  "main": "electron/main.cjs",
  "description": "Lost Marcus - a dark top-down roguelike",
  "steam": {
    "appId": 0,
    "depotId": 0
  },
  "author": "Papermoth Games",
  "build": {
    "appId": "com.racinedigital.lostmarcus",
    "productName": "Lost Marcus",
    "copyright": "\u00a9 Papermoth Games",
    "directories": {
      "output": "release-desktop",
      "buildResources": "electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/discord.cjs",
      "electron/distribution.cjs",
      "electron/steam.cjs",
      "electron/icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "extraResources": [
      {
        "from": "dist-single",
        "to": "game",
        "filter": [
          "index.html",
          "music/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lost Marcus",
      "artifactName": "Lost-Marcus-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lost-Marcus-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "electron/icon.png",
      "artifactName": "Lost-Marcus-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RacineDigital",
        "repo": "Binding-of-marcus",
        "releaseType": "release"
      }
    ]
  }
}
